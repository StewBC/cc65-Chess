/.vs/
/.vscode/
/obj/
/Makefile.options
/cc65-Chess*.*
/chess.po
/scratch/
# the Sargon II harness is tracked; its disk image is not.  Sargon II is a
# commercial 1978 program and the image is nobody's to redistribute - sargon/README.md
# says what the harness expects and how to check you have the right one
/sargon/*.dsk
/sargon/*.nib
/sargon/*.po
/atari.atr/

# native test binaries and their debug info
/tests/chesstest
/tests/uci
/tests/uci-tuning
/tests/genbook
*.dSYM/

# cc65 benchmark builds, and compiler leftovers
*.prg
*.o

# fastchess drops a resume file wherever it is invoked.  the gauntlet disables
# it, but a hand-run match will still leave one
/config.json
/tests/config.json

# match runners and reference engines: fetched locally, never vendored.
# the README explaining what belongs here is the one thing that is tracked
/tools/*
!/tools/README.md
